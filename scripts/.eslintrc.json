{
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "AudioDecoder": "readonly",
    "EncodedAudioChunk": "readonly",
    "EncodedVideoChunk": "readonly",
    "MediaStreamTrackGenerator": "readonly",
    "OffscreenCanvas": "readonly",
    "VideoDecoder": "readonly",
    "VideoFrame": "readonly",
    "VideoTrackGenerator": "readonly",
    "WeakRef": "readonly"
  },
  "rules": {
    "no-undef": "error"
  }
}
